[Unit]
Description=Hourly Wallpaper Generator (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wallpaper_gen
ExecStart=/opt/wallpaper_gen/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5

# Credentials are in /opt/wallpaper_gen/.env, NOT in the repo
EnvironmentFile=/opt/wallpaper_gen/.env

[Install]
WantedBy=multi-user.target
